{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-local-image/types/**/*.ts",
    ".next-local-image/dev/types/**/*.ts",
    ".next-local-jpeg/types/**/*.ts",
    ".next-local-jpeg/dev/types/**/*.ts",
    ".next-local-timeline/types/**/*.ts",
    ".next-local-timeline/dev/types/**/*.ts",
    ".next-local-chord/types/**/*.ts",
    ".next-local-chord/dev/types/**/*.ts",
    ".next-local-lyrics/types/**/*.ts",
    ".next-local-lyrics/dev/types/**/*.ts",
    ".next-local-lyrics-followup/types/**/*.ts",
    ".next-local-lyrics-followup/dev/types/**/*.ts",
    ".next-local-ending/types/**/*.ts",
    ".next-local-ending/dev/types/**/*.ts",
    ".next-local-assisted/types/**/*.ts",
    ".next-local-assisted/dev/types/**/*.ts",
    ".next-local-assisted-proof/types/**/*.ts",
    ".next-local-assisted-proof/dev/types/**/*.ts",
    ".next-local-review-persistence/types/**/*.ts",
    ".next-local-review-persistence/dev/types/**/*.ts",
    ".next-local-review-persistence-bytes/types/**/*.ts",
    ".next-local-review-persistence-bytes/dev/types/**/*.ts",
    ".next-local-review-persistence-transfer/types/**/*.ts",
    ".next-local-review-persistence-transfer/dev/types/**/*.ts",
    ".next-local-review-persistence-ui/types/**/*.ts",
    ".next-local-review-persistence-ui/dev/types/**/*.ts",
    ".next-local-review-persistence-serialized/types/**/*.ts",
    ".next-local-review-persistence-serialized/dev/types/**/*.ts",
    ".next-local-review-persistence-render/types/**/*.ts",
    ".next-local-review-persistence-render/dev/types/**/*.ts",
    ".next-local-review-persistence-combined/types/**/*.ts",
    ".next-local-review-persistence-combined/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
