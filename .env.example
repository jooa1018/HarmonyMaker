DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
S3_ENDPOINT=https://s3-compatible.example
S3_REGION=region-1
S3_BUCKET=private-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Independent base64url deployment keys. Generate outside the application.
SESSION_TOKEN_HMAC_KEY=base64url-at-least-32-bytes
CSRF_HMAC_KEY=base64url-at-least-32-bytes
SHARE_ENCRYPTION_KEY=base64url-exactly-32-bytes
SHARE_TOKEN_HMAC_KEY=base64url-at-least-32-bytes
OWNER_DELETE_HMAC_KEY=base64url-at-least-32-bytes
QUOTA_IP_HMAC_KEY=base64url-at-least-32-bytes
INTERNAL_OPERATIONS_KEY=base64url-at-least-32-bytes
# Vercel Cron sends this exact value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=unguessable-at-least-32-characters
# OMR keys are independent exact 32-byte base64url deployment keys.
OMR_HANDLE_HMAC_KEY=base64url-exactly-32-bytes
OMR_VENDOR_JOB_ENCRYPTION_KEY=base64url-exactly-32-bytes
OMR_DAILY_GLOBAL_CREDIT_CEILING=positive-integer-deployment-budget
OMR_PROVIDER_MODE=unconfigured
# Required when OMR_PROVIDER_MODE=real. Audiveris is self-hosted and has no per-page API fee.
OMR_AUDIVERIS_BASE_URL=https://your-audiveris-provider.example
OMR_AUDIVERIS_API_KEY=unguessable-at-least-32-characters
OMR_AUDIVERIS_CONFIGURATION_GENERATION=audiveris-5.10.2-self-hosted-v1
OMR_AUDIVERIS_REQUEST_TIMEOUT_MS=180000
